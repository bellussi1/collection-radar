{
  "name": "collection-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Radar local de livros usados e importados para coleção física.",
  "scripts": {
    "scan": "tsx src/index.ts scan",
    "digest": "tsx src/index.ts digest",
    "email:test": "tsx src/index.ts email-test",
    "enrich": "tsx src/enrich.ts",
    "dashboard": "tsx src/dashboard.ts",
    "rematch": "tsx src/rematch.ts",
    "watchlist": "tsx src/index.ts watchlist",
    "sources": "tsx src/index.ts sources",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "nodemailer": "^7.0.11",
    "playwright": "^1.65.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
