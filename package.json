{
  "name": "collection-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Radar local de livros usados e importados para coleção física.",
  "scripts": {
    "scan": "tsx src/index.ts scan",
    "digest": "tsx src/index.ts digest",
    "email:test": "tsx src/index.ts email-test",
    "enrich": "tsx src/enrich.ts",
    "dashboard": "tsx src/dashboard.ts",
    "update": "tsx src/update.ts",
    "backup": "tsx src/backup.ts",
    "rematch": "tsx src/rematch.ts",
    "covers": "tsx src/covers.ts",
    "isbn-scan": "tsx src/isbn-scan.ts",
    "ocr": "tsx src/ocr.ts",
    "shopee:login": "tsx scripts/shopee-login.ts",
    "shopee-scan": "tsx src/shopee-scan.ts",
    "sebos-scan": "tsx src/sebos-scan.ts",
    "sellers:backfill": "tsx scripts/backfill-seller-ratings.ts",
    "fixtures:capture": "tsx scripts/capture-fixtures.ts",
    "watchlist": "tsx src/index.ts watchlist",
    "sources": "tsx src/index.ts sources",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "nodemailer": "^7.0.11",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
