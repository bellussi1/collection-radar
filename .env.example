# E-mail (opcional). Para Gmail, use uma senha de app, nunca a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=enzobellussi3@gmail.com

# Mercado Livre (opcional). Crie um app em https://developers.mercadolivre.com.br
ML_ACCESS_TOKEN=

# Google Books (opcional). Sem chave, a API costuma responder 429.
# Crie uma chave gratuita no Google Cloud Console e habilite a Books API.
GOOGLE_BOOKS_API_KEY=

# Playwright: OLX e Mercado Livre bloqueiam headless. Deixe false para usar
# uma janela do Chromium fora da tela. Use true só para testar fontes que aceitam.
HEADLESS=false

# Shopee: faça login uma vez com npm run shopee:login.
# O perfil persistente fica em data/shopee-profile por padrão.
SHOPEE_PROFILE_DIR=

# Opcional: URL de uma busca salva da Shopee. Use {query} no lugar do termo.
SHOPEE_SEARCH_URL=
